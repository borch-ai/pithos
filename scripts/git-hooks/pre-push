#!/bin/sh

# pre-push git hook
# Runs powerword review --local to ensure quality gates and critic checks pass before pushing.

echo "Running pre-push quality and critic checks..."

# 1. Verify CI configuration matches local replacement directives
echo "Verifying CI configuration matches local replacement directives..."
replaces=$(grep -E '^[[:space:]]*replace[[:space:]]+github.com/borch-ai/[a-zA-Z0-9_-]+[[:space:]]+=>' go.mod | awk '{print $2}')

for repl in $replaces; do
  repo_name=$(echo "$repl" | sed 's|github.com/borch-ai/||')
  echo "Checking dependency: $repo_name"

  # Accept either:
  #   (a) an inline checkout step:       repository: borch-ai/<repo>
  #   (b) a reusable workflow input:     sibling-repo: borch-ai/<repo>
  if ! grep -qE "(repository:|sibling-repo:)[[:space:]]+borch-ai/$repo_name" .github/workflows/ci.yml; then
    echo "Error: go.mod replaces 'github.com/borch-ai/$repo_name' with a local sibling, but .github/workflows/ci.yml is missing a checkout step or sibling-repo input for 'borch-ai/$repo_name'."
    exit 1
  fi

  # Accept either:
  #   (a) an explicit token on the checkout step if checked out inline
  #   (b) secrets: inherit if checked out via reusable workflow
  if grep -q "repository: borch-ai/$repo_name" .github/workflows/ci.yml; then
    if ! grep -A 5 "repository: borch-ai/$repo_name" .github/workflows/ci.yml | grep -q -E 'token: \$\{\{[[:space:]]*(secrets\.|github\.token|steps\.)'; then
      echo "Error: .github/workflows/ci.yml checks out sibling repository '$repo_name' inline but does not configure a token (e.g. token: \${{ github.token }} or \${{ secrets.PAT_TOKEN }})."
      exit 1
    fi
  fi

  if grep -q "sibling-repo: borch-ai/$repo_name" .github/workflows/ci.yml; then
    if ! grep -q "secrets: inherit" .github/workflows/ci.yml; then
      echo "Error: .github/workflows/ci.yml uses a reusable workflow for sibling repository '$repo_name' but does not specify 'secrets: inherit' to delegate authentication."
      exit 1
    fi
  fi
done

# 2. Check if powerword is installed
if ! command -v powerword >/dev/null 2>&1; then
  echo "Error: 'powerword' CLI tool is not installed or not in PATH."
  echo "Please install it or build it from the powerword repository."
  exit 1
fi

# Run the review command
# Unset Git hook environment variables to prevent interfering with go builds / nested git invocations in tests
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

if ! powerword review --local; then
  echo ""
  echo "Error: Critic rejected the push or local validation failed."
  echo "Review the feedback in .powerword-critic.md and fix the issues."
  exit 1
fi

echo "All checks passed. Proceeding with push."
exit 0
